configuration {
    modes: [ "drun" ];
    drun-display-format: "{name}";
    icon-theme: "Papirus-Dark";
    show-icons: true;
    terminal: "alacritty";
    matching: "fuzzy";
    sort: true;
    sorting-method: "fzf";
    disable-history: false;
    steal-focus: false;
}

@theme "~/.config/rofi/tokyonight.rasi"
